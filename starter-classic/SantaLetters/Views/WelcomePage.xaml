<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SantaLetters.ViewModels"
             x:Class="SantaLetters.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             Title="Welcome">

    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource HeaderBand}">
            <Label Text="🎅 Letters to Santa" Style="{StaticResource HeaderTitle}" />
        </Border>

        <ScrollView Grid.Row="1">
            <Grid ColumnDefinitions="*,*" Padding="48,32" ColumnSpacing="48">
                <VerticalStackLayout VerticalOptions="Center" Spacing="16">
                    <Label Text="🎄✉️🎁" FontSize="110" HorizontalOptions="Center" />
                    <Label Style="{StaticResource Heading}" HorizontalTextAlignment="Center"
                           Text="Ho ho ho! Santa can't wait to hear from you!" />
                    <Label Style="{StaticResource Body}" HorizontalTextAlignment="Center"
                           Text="Pick your presents, write your letter and tell Santa how good you've been." />
                </VerticalStackLayout>

                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="What's your name?" Style="{StaticResource Heading}" />
                        <Entry Text="{Binding ChildName}" Placeholder="Type your name here"
                               FontSize="30" MinimumHeightRequest="80" MaxLength="30"
                               Keyboard="Text" ReturnCommand="{Binding StartCommand}" />

                        <Label Text="How old are you?" Style="{StaticResource Heading}" />
                        <HorizontalStackLayout Spacing="32" HorizontalOptions="Center">
                            <Button Text="−" Style="{StaticResource RoundButton}" Command="{Binding DecreaseAgeCommand}"
                                    SemanticProperties.Description="Younger" />
                            <Label Text="{Binding Age}" FontSize="56" FontAttributes="Bold" TextColor="{StaticResource Ink}"
                                   VerticalOptions="Center" WidthRequest="90" HorizontalTextAlignment="Center" />
                            <Button Text="+" Style="{StaticResource RoundButton}" Command="{Binding IncreaseAgeCommand}"
                                    SemanticProperties.Description="Older" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" HorizontalTextAlignment="Center" />

                        <Button Text="Start my letter ✏️" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
