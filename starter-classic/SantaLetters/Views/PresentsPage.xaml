<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SantaLetters.Views.PresentsPage"
             Title="Choose presents">

    <!-- TODO (Stage 1): show IPresentCatalog.All as big tappable tiles (try a CollectionView with a
         GridItemsLayout, Span="6") and let the child pick up to LetterValidator.MaxPresents.
         Save the choices into LetterDraft.Presents, then navigate on to the letter page. -->
    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource HeaderBand}">
            <Label Text="🎁 Choose your presents" Style="{StaticResource HeaderTitle}" />
        </Border>
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16">
            <Label Text="🧝" FontSize="110" HorizontalOptions="Center" />
            <Label Text="The elves haven't built this page yet... that's your job!"
                   Style="{StaticResource Heading}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
