<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SantaLetters.ViewModels"
             x:Class="SantaLetters.Views.PresentsPage"
             x:DataType="vm:PresentsViewModel"
             Title="Choose presents">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Style="{StaticResource HeaderBand}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="🎁 Choose your presents" Style="{StaticResource HeaderTitle}" />
                <Label Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource HeaderSubtitle}" />
            </Grid>
        </Border>

        <Label Grid.Row="1" Text="{Binding Greeting}" Style="{StaticResource Heading}" Margin="40,16,40,0" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Presents}" Margin="32,8"
                        SelectionMode="Single" SelectedItem="{Binding TappedPresent, Mode=TwoWay}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="16" VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PresentItemViewModel">
                    <Border Style="{StaticResource Card}" Padding="8" HeightRequest="170"
                            SemanticProperties.Description="{Binding Present.Name}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Gold}" />
                                <Setter Property="StrokeThickness" Value="6" />
                                <Setter Property="BackgroundColor" Value="{StaticResource HollyGreenLight}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid RowDefinitions="*,Auto">
                            <Label Text="{Binding Present.Emoji}" FontSize="64"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="{Binding Present.Name}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                            <Label Text="✅" FontSize="30" HorizontalOptions="End" VerticalOptions="Start"
                                   IsVisible="{Binding IsSelected}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" Style="{StaticResource Footer}" ColumnDefinitions="Auto,*,Auto">
            <Button Text="◀ Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
            <Border x:Name="SleighBanner" Grid.Column="1" IsVisible="{Binding HasStatusMessage}"
                    BackgroundColor="{StaticResource Gold}" Stroke="{StaticResource SantaRed}" StrokeThickness="4"
                    StrokeShape="RoundRectangle 30" Padding="24,12"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{Binding StatusMessage}" FontSize="30" FontAttributes="Bold"
                       TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level2" />
            </Border>
            <Button Grid.Column="2" Text="Next: my letter ▶" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</ContentPage>
