<?xml version="1.0" encoding="utf-8" ?>
<controls:StoryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:vm="clr-namespace:SantaLetters.ViewModels"
                    xmlns:controls="clr-namespace:SantaLetters.Controls"
                    x:Class="SantaLetters.Views.WorkshopPage"
                    x:DataType="vm:WorkshopViewModel"
                    Title="Santa's Workshop">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:StoryHeader Title="Santa's Workshop" Subtitle="{Binding StatsText}"
                              Band="{StaticResource WorkshopHeaderBrush}" />

        <Grid Grid.Row="1" ColumnDefinitions="2*,*" Padding="32,16" ColumnSpacing="24">
            <Grid RowDefinitions="Auto,*">
                <Label Text="Letters from the children" Style="{StaticResource Heading}" Margin="0,0,0,12" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding Letters}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No letters yet. The elves are waiting! 🧝" FontFamily="StoryItalic" Margin="0,24" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LetterCard">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                                    <Label Text="{Binding Title}" Style="{StaticResource Heading}" FontSize="32" />
                                    <Label Grid.Row="1" Text="{Binding SentText}" FontFamily="StoryItalic" FontSize="19" TextColor="{StaticResource InkSoft}" />
                                    <Label Grid.Row="2" Text="{Binding PresentsText}" />
                                    <Label Grid.Row="3" Text="{Binding ExtraWishes}" Style="{StaticResource Handwriting}" FontSize="24"
                                           IsVisible="{Binding HasExtraWishes}" />
                                    <Border Grid.Column="1" Background="{StaticResource BerryButtonBrush}" Stroke="{StaticResource Gold}"
                                            StrokeThickness="2" StrokeShape="RoundRectangle 18" Padding="16,4" HorizontalOptions="End">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsNice}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HollyButtonBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding VerdictText}" FontFamily="ChristmasTitle" FontSize="24" TextColor="{StaticResource GoldLight}" />
                                    </Border>
                                    <Button Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Text="Delete"
                                            Style="{StaticResource SecondaryButton}" FontSize="22" MinimumHeightRequest="64"
                                            VerticalOptions="End"
                                            Command="{Binding DeleteCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource LetterPaper}" VerticalOptions="Start">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🧝 Elves' production list" Style="{StaticResource Heading}" FontSize="32" />
                    <Label Text="Presents for nice children only!" FontFamily="StoryItalic" FontSize="20" />
                    <Label Style="{StaticResource Flourish}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Production}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="Nothing to make yet." FontFamily="StoryItalic" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductionItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding Emoji}" FontSize="30" />
                                    <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Count, StringFormat='× {0}'}" Style="{StaticResource Handwriting}"
                                           FontFamily="HandwritingBold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Style="{StaticResource Footer}" ColumnDefinitions="Auto,*">
            <Button Text="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
        </Grid>
    </Grid>
</controls:StoryPage>
