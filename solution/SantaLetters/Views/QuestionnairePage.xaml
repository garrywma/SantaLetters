<?xml version="1.0" encoding="utf-8" ?>
<controls:StoryPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:vm="clr-namespace:SantaLetters.ViewModels"
                    xmlns:controls="clr-namespace:SantaLetters.Controls"
                    x:Class="SantaLetters.Views.QuestionnairePage"
                    x:DataType="vm:QuestionnaireViewModel"
                    Title="Naughty or nice">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <controls:StoryHeader Title="Naughty or Nice?" Subtitle="{Binding ProgressText}" />

        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" HeightRequest="14" Margin="96,20,96,0" />

        <Border x:Name="QuestionCard" Grid.Row="2" Style="{StaticResource LetterPaper}"
                Margin="120,16" Padding="48,24" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="{Binding CurrentQuestion.Emoji}" FontSize="96" HorizontalOptions="Center" />
                <Label Text="{Binding CurrentQuestion.Text}" Style="{StaticResource Heading}" FontSize="42"
                       HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource Flourish}" />
                <HorizontalStackLayout Spacing="56" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Button Text="✓  Yes" Style="{StaticResource PrimaryButton}" Command="{Binding YesCommand}" />
                    <Button Text="✗  No" Style="{StaticResource BerryButton}" Command="{Binding NoCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="3" Style="{StaticResource Footer}" ColumnDefinitions="Auto,*">
            <Button Text="Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="Be honest - Santa always knows! 🎅" FontFamily="StoryItalic" FontSize="26"
                   HorizontalOptions="End" VerticalOptions="Center" />
        </Grid>
    </Grid>
</controls:StoryPage>
